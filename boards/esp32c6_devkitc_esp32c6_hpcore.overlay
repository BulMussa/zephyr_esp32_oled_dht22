/*
 * DHT22 sensor connected to GPIO20.
 * 0.96" SSD1306 128x64 OLED on I2C0: SCL = GPIO0, SDA = GPIO1.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/esp32c6-pinctrl.h>

/ {
	chosen {
		zephyr,display = &oled;
		/* Console on the USB port used for flashing (/dev/ttyACM0) */
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
	};

	dht22: dht22 {
		compatible = "aosong,dht";
		status = "okay";
		dio-gpios = <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		dht22;
	};
};

&gpio0 {
	status = "okay";
};

&usb_serial {
	status = "okay";
};

&i2c0_default {
	group1 {
		pinmux = <I2C0_SDA_GPIO1>,
			 <I2C0_SCL_GPIO0>;
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;

	oled: ssd1306@3c {
		compatible = "solomon,ssd1306";
		reg = <0x3c>;
		width = <128>;
		height = <64>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		segment-remap;
		com-invdir;
		prechargep = <0x22>;
	};
};
